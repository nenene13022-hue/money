rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function householdPath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }

    function memberPath(hid) {
      return /databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid);
    }

    function isMember(hid) {
      return signedIn() && exists(memberPath(hid));
    }

    function household(hid) {
      return get(householdPath(hid)).data;
    }

    // The invite code is the secret. A signed-in person who knows it can look up
    // the household id. Listing every code is not allowed.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['householdId'])
        && request.resource.data.householdId is string
        && household(request.resource.data.householdId).ownerUid == request.auth.uid
        && household(request.resource.data.householdId).inviteCode == code;
      allow update, delete: if false;
    }

    match /households/{hid} {
      allow get: if isMember(hid);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 6
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 1
        && request.auth.uid in request.resource.data.memberUids;
      allow update: if isMember(hid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.memberUids is list
        && (
          request.resource.data.memberUids == resource.data.memberUids
          || (
            request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
            && request.resource.data.memberUids.hasAll(resource.data.memberUids)
            && request.auth.uid in request.resource.data.memberUids
            && !(request.auth.uid in resource.data.memberUids)
          )
          || (
            request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
            && resource.data.memberUids.hasAll(request.resource.data.memberUids)
            && request.auth.uid in resource.data.memberUids
            && !(request.auth.uid in request.resource.data.memberUids)
          )
        );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /members/{uid} {
        allow read: if isMember(hid);
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && (
            household(hid).ownerUid == request.auth.uid
            || request.resource.data.inviteCode == household(hid).inviteCode
          );
        allow update: if isMember(hid) && request.auth.uid == uid;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /transactions/{txId} {
        allow read: if isMember(hid);
        allow create: if isMember(hid)
          && request.resource.data.id == txId
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(hid)
          && request.resource.data.id == txId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if isMember(hid);
      }

      match /recurring/{rid} {
        allow read: if isMember(hid);
        allow create: if isMember(hid) && request.resource.data.id == rid;
        allow update, delete: if isMember(hid);
      }

      match /meta/{docId} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid);
        allow delete: if false;
      }
    }
  }
}
